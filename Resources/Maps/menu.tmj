        },
        {
         "id": 190,
         "name": "",
         "type": "obj_menu_abouttext",
         "gid": 156,
         "x": 23.0,
         "y": 60.0,
         "width": 8.0,
         "height": 6.0,
         "rotation": -0.0,
         "visible": true,
         "properties": [
          {
           "name": "text",
           "type": "string",
           "value": "\\exetior~ is slightly slower  \nthan the other killers, but  \nhe is capable of making that \nup with his great offense.he\nhas a \\stomp~, it sends out \na shockwave upon landing,  \ndealing damage. his special  \nis placing down a \\black ring~,\nthat allows him to track    \nnearest survivors. however,  \nblack rings can be countered \nby taking them with 5 rings  \nin stock. he can also cancel \nhis spin, this will allow him\nto avoid bouncing off of     \nsurvivors. all killers can do\nthat. \n \nexetior is an antagonist of   \nsonic.exe nightmare universe,\nmade by @j\u0430izkoys~ in 2017"
          }
         ]
        },
